# Copy to android/keystore.properties and fill in with your real values.
#
# keystore.properties is GITIGNORED and must stay that way. This .example file
# exists so the required keys are discoverable without the secrets being in the
# repository.
#
# storeFile is resolved relative to android/app/. Keeping the .jks OUTSIDE the
# repo entirely is safer than relying on a gitignore rule that a future `git add
# -f` could bypass.

storeFile=../../gdimension-upload.jks
storePassword=CHANGEME
keyAlias=gdimension
keyPassword=CHANGEME
