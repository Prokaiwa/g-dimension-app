<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App Store privacy manifest. Apple requires this file for every app; without
  it, App Store Connect answers the upload with an automated rejection email
  rather than a review note, which is a slow way to learn you needed it.

  Two independent things live here:

  1. NSPrivacyAccessedAPITypes — "required reason" APIs. These are ordinary
     system APIs that were historically abused for fingerprinting, so Apple
     now wants a declared reason code for each one. You declare what YOUR code
     and any statically linked code use. Swift Package dependencies (the
     Capacitor packages under CapApp-SPM) ship their own manifests and are NOT
     restated here.

  2. NSPrivacyCollectedDataTypes — what leaves the device. This must agree
     with the App Privacy answers in App Store Connect and with
     src/pages/PrivacyPolicyPage.tsx. Three places, one set of facts. If you
     change what the app collects, change all three.

  NOTHING here is tracking in Apple's sense: no ad network, no data broker, no
  linking of this app's data to third-party data for advertising. Hence
  NSPrivacyTracking=false and an empty NSPrivacyTrackingDomains.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>

	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- Capacitor's bridge and the WebView shell persist local state
		     (active car, sound preference, recent searches) via UserDefaults
		     backing. CA92.1 = "access info from the app itself", which is the
		     whole of it: nothing read here comes from another app or is sent
		     off device. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Supabase auth. Used to sign you in and to reach you about the
		     account. Never sold, never used for advertising. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Display name and @handle. Public on a shared build by design. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- The account's user id. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Car, mod, receipt and timeline photos uploaded to Supabase
		     Storage. Receipts and documents live in PRIVATE buckets served by
		     expiring signed URLs; the rest is public only if the owner
		     publishes the build. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Everything the user writes: build sheet entries, service records,
		     DIY guides, timeline journal, and the profile's free-text city and
		     country. Note that city/country are TYPED, never read from device
		     location services, which is why no Location type is declared. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Sentry. Errors only, no session replay, no performance traces
		     (tracesSampleRate: 0, integrations: [] in lib/errorTracking.ts). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Vercel Web Analytics. Aggregate page views, no cookies, no
		     cross-site identifier. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
